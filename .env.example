# R.O.S.E (Project Mirror) - Environment Configuration
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` to Git!

# ── Phase 6: Telegram Remote Control ────────────────────────────────────────
# 1. Create a bot with @BotFather on Telegram (/newbot) and paste the token here:
TELEGRAM_BOT_TOKEN=
# 2. Message @userinfobot on Telegram to get your numeric User ID.
#    Comma-separated list for multiple authorized owner accounts:
TELEGRAM_ALLOWED_USER_IDS=

# ── Phase 2: WhatsApp Sidecar (Optional Overrides) ──────────────────────────
ROSE_WHATSAPP_PORT=48201
ROSE_WHATSAPP_TOKEN=rose_wa_secret_token_default

# ── Phase 3: Job Command Center (Optional Reddit PRAW) ──────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ROSE-JobRadar/3.0

# ── Phase 7: SwiftSats Read-Only Connector ──────────────────────────────────
# Allowed modes: disabled (default) | mock | live
SWIFTSATS_MODE=disabled
SWIFTSATS_BASE_URL=
SWIFTSATS_API_TOKEN=
# Optional read-only Postgres DSN (SELECT only; never used for writes):
SWIFTSATS_READONLY_DSN=


