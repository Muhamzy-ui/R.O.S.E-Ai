{
  "manifest_version": 3,
  "name": "R.O.S.E Autofill Copilot",
  "version": "1.0.0",
  "description": "Manifest V3 one-click job application autofill across Greenhouse, Lever, Ashby, Workable, Indeed, iframes, and shadow DOM. Never auto-submits.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "R.O.S.E Autofill Copilot"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "trigger-autofill": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Autofill the current job application form with your R.O.S.E profile"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": [
        "src/dom_utils.js",
        "src/adapters.js",
        "src/autofill_engine.js",
        "content.js"
      ],
      "css": [
        "styles/overlay.css"
      ]
    }
  ]
}

